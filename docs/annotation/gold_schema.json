{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culinarystate/DEL3-GOLD-v0",
  "title": "DEL-3 gold recipe annotation (one annotator, one recipe)",
  "description": "Structural schema. Semantic validity (lots exist, no reuse, no over-allocation) is enforced by replaying the events through the state engine: tools/validate_gold.py runs both.",
  "type": "object",
  "required": ["gold_format", "recipe_id", "annotator", "steps"],
  "additionalProperties": true,
  "properties": {
    "gold_format": {"const": "DEL3-GOLD-v0"},
    "recipe_id": {"type": "string", "minLength": 1, "description": "RecipeDB Recipe_ID for real gold; FIX-… only for fixtures/examples (never in the benchmark test set)"},
    "annotator": {"type": "string", "minLength": 1},
    "guideline_version": {"type": "string"},
    "source_text": {"type": "string"},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["step"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "text": {"type": "string"},
          "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
        }
      }
    }
  },
  "$defs": {
    "amount": {
      "type": "object", "required": ["raw"],
      "properties": {
        "raw": {"type": "string", "description": "verbatim quantity text"},
        "unit": {"type": ["string", "null"]},
        "value": {"type": ["number", "null"]}, "lo": {"type": ["number", "null"]}, "hi": {"type": ["number", "null"]}
      }
    },
    "lot": {
      "type": "object", "required": ["id"],
      "properties": {
        "id": {"type": "string", "description": "local lot id; becomes ENTITY-<recipe>-<id>; never reused"},
        "concept": {"type": ["string", "null"], "description": "food concept (ING- slug or plain name); null for intermediates"},
        "label": {"type": "string"},
        "qty": {"$ref": "#/$defs/amount"},
        "fraction": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "field_spec": {
      "oneOf": [
        {"type": ["string", "number", "boolean"]},
        {"type": "object", "properties": {"value": {}, "unit": {"type": "string"}, "lo": {"type": "number"}, "hi": {"type": "number"}}}
      ]
    },
    "event": {
      "type": "object", "required": ["op"],
      "properties": {
        "op": {"enum": ["CREATE", "TRANSFORM", "MERGE", "SPLIT", "RESERVE", "DISCARD", "RECOMBINE", "TRANSFER", "SET_FIELD", "OBSERVE",
                        "OMITTED_STEP_CANDIDATE", "ACCEPT_CANDIDATE", "REJECT_CANDIDATE",
                        "create", "transform", "merge", "split", "reserve", "discard", "recombine", "transfer", "set_field", "observe"]},
        "input": {"type": "string"}, "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/lot"}},
        "process": {"type": ["string", "null"], "description": "verb as written; resolved through the PROC vocabulary; unmapped verbs keep raw text"},
        "location": {"type": ["string", "null"]},
        "span": {"type": ["string", "null"], "description": "verbatim text span supporting the event"},
        "plan": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field_spec"}, "description": "PLANNED state/endpoint fields"},
        "observe": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field_spec"}, "maxProperties": 1},
        "id": {"type": "string"}, "proposes": {"type": "object"}, "rationale": {"type": "string"}
      }
    }
  }
}
